{
  "experiment_id": "exp050",
  "checkpoint_path": "experiments/exp050/checkpoint/best",
  "dataset_version": "v4 (BIPIA + 1000 Enron emails)",
  "random_seed": 42,
  "config_file": "configs/student.yaml",
  "teacher_model": "Qwen (frozen, offline-only)",
  "student_model": "answerdotai/ModernBERT-base (149M params)",
  "distillation": {
    "loss_type": "kd",
    "temperature": 4.0,
    "alpha": 0.7
  },
  "training": {
    "optimizer": "AdamW",
    "learning_rate": "2.0e-05",
    "batch_size": 8,
    "gradient_accumulation_steps": 8,
    "effective_batch_size": 64,
    "max_length": 512,
    "num_epochs": 30,
    "early_stopping_patience": 3,
    "weight_decay": 0.01,
    "warmup_ratio": 0.1,
    "max_grad_norm": 1.0,
    "monitor_metric": "f1"
  }
}